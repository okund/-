/* 首页样式 */

/* 用户信息头部 */
.header-card {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  min-height: 200rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #C0392B;
}

.header-content {
  position: relative;
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  z-index: 1;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.6);
  overflow: hidden;
  flex-shrink: 0;
  background: #fff;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.header-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.user-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.header-badge {
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
}

.badge-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

/* 离线提示 */
.offline-banner {
  background: #FFF3E0;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #E67E22;
  text-align: center;
}

/* 轮播图 */
.banner-swiper {
  width: 100%;
  height: 280rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.banner-swiper swiper-item {
  position: relative;
}

.banner-img {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

/* 统计卡片 */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  margin-bottom: 0;
}

.stat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  font-size: 32rpx;
}

.stat-icon-dorm {
  background: #EBF0FA;
}

.stat-icon-class {
  background: #FEF5E7;
}

.stat-icon-intern {
  background: #E8F8F5;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #2C3E50;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #95A5A6;
}

/* 功能列表 */
.section-title {
  margin-bottom: 20rpx;
}

.section-title-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #2C3E50;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  gap: 24rpx;
}

.feature-hover {
  opacity: 0.9;
  transform: scale(0.98);
}

.feature-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 40rpx;
}

.feature-dorm-bg {
  background: #EBF0FA;
}

.feature-class-bg {
  background: #FEF5E7;
}

.feature-intern-bg {
  background: #E8F8F5;
}

.feature-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feature-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C3E50;
}

.feature-desc-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.feature-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 4rpx;
}

.feature-arrow {
  font-size: 40rpx;
  color: #BDC3C7;
  font-weight: 300;
}

/* 每日思政 */
.daily-thought {
  margin-top: 8rpx;
}

.daily-header {
  margin-bottom: 16rpx;
}

.daily-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2C3E50;
}

.daily-content {
  font-size: 26rpx;
  color: #555;
  line-height: 1.8;
}
