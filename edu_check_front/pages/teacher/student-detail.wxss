.page-container {
  padding: 30rpx;
}
.loading, .empty-row {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}
.student-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.student-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 24rpx;
}
.student-avatar image {
  width: 100%;
  height: 100%;
}
.student-info {
  flex: 1;
}
.student-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C3E50;
}
.student-id-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin: 6rpx 0;
}
.student-college {
  font-size: 24rpx;
  color: #666;
}
.stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.stat-item {
  flex: 1;
  padding: 24rpx;
  text-align: center;
}
.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #2C3E50;
}
.stat-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
  margin: 20rpx 0 16rpx;
}
.checkin-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}
.checkin-status {
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-right: 20rpx;
}
.status-present {
  background: #E8F5E9;
  color: #00B894;
}
.status-late {
  background: #FFF3E0;
  color: #F39C12;
}
.status-absent {
  background: #FFEBEE;
  color: #E74C3C;
}
.checkin-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 24rpx;
  color: #666;
}
.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}
.record-date {
  flex: 1;
  font-size: 26rpx;
  color: #2C3E50;
}
.record-status {
  font-size: 24rpx;
  font-weight: 500;
  margin: 0 20rpx;
}
.record-time {
  font-size: 24rpx;
  color: #999;
}
.text-success { color: #00B894; }
.text-warning { color: #F39C12; }
.text-danger { color: #E74C3C; }
